# Clawco Sky (the control plane) — key names only. The real file is /srv/sky/.env on the
# control server (see sky/deploy/README.md), set with sky/scripts/saet-hemmelighed.sh.
# Never commit values. Later tickets add their keys here in the commit that uses them.

# Required. Postgres on the same server, e.g. a socket URL with peer auth (no password).
SKY_DATABASE_URL=
# Required. The control plane's own public address (http or https).
SKY_PUBLIC_URL=
# Optional. Port on 127.0.0.1; default 8781.
SKY_PORT=
# Optional. The tenant domain (<slug>.<domain>); default lives in sky/src/config.ts.
SKY_BASEDOMAIN=
# Optional. Passkey relying-party id; default is the host of SKY_PUBLIC_URL. Only that host or a
# dotted domain it lies under (gate G7: login lives on the Sky host, cookies are host-only).
SKY_RP_ID=
# Optional. 1 = local development: fake mail with an outbox page at /dev/udbakke. Never in production.
SKY_DEV=
# Optional (KC-0198). Sign-up mode: invitation (default, closed beta: an invite code instead of the plan step)
# or open (the plan step, Checkout with a trial). Never both at once.
SKY_TILMELDING=

# Stripe (KC-0190): on Henrik's Stripe account; the prefix decides test or live. Test mode: sk_test_… or
# rk_test_…; live mode: a RESTRICTED key (rk_live_…) only, sk_live_ is refused. Used by `npm run
# stripe:opsaet` and by Checkout/webhooks (KC-0191/KC-0192). A live --anvend also needs
# SKY_STRIPE_LIVE_OK=ja on the command line for that one run (never in this file). Unset: the billing
# pages answer 503 (with SKY_DEV=1 a fake Stripe is used instead).
SKY_STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_…), for POST /api/abonnement/webhook (KC-0192).
# Unset: the webhook answers 503, never 200.
SKY_STRIPE_WEBHOOK_SECRET=
# Optional. Public https URLs of the terms and the privacy policy (KC-0174), linked next to Stripe's
# terms checkbox. Live Checkout refuses without them.
SKY_VILKAAR_URL=
SKY_PRIVATLIV_URL=

# Fleet (KC-0212): which driver provisions tenants. ingen (default) = nothing is provisioned and
# account deletion of an owner refuses; lokal = Docker on this host (the beta on kira-home);
# hetzner = refuses until config/omkostninger.json has an active, covered Hetzner line (KC-0182).
SKY_FLAADE=
# Required with lokal: the tenant image (KC-0157), name:tag.
SKY_TENANT_BILLEDE=
# Optional with lokal: the Docker network tenants live on; default clawco-sky. Sky creates it with traffic
# between containers switched off and refuses an existing one that allows it (tenants must not see each other).
SKY_TENANT_NETVAERK=
# Required with lokal (KC-0182): the gateway's Ed25519 public key, raw 32 bytes as base64url without padding
# (43 characters). Every tenant gets it as KC_KONTO_PUBKEY and trusts only headers signed with its private
# half (KC-0179/KC-0183). Public, not a secret.
SKY_KONTO_PUBKEY=
# KC-0183: the gateway's Ed25519 signing key — the 32-byte seed as base64url without padding (43 characters),
# the private half of SKY_KONTO_PUBKEY. Signs Clawco-Konto on every request to a tenant and keys the tenant
# cookie. Unset or not matching SKY_KONTO_PUBKEY: every tenant address answers 503 and /health says
# gateway: mangler. Set with sky/scripts/saet-hemmelighed.sh; rotation in sky/deploy/gateway/README.md.
SKY_GATEWAY_SIGNERINGSNOEGLE=

# Cloudflare Tunnel (KC-0212): the token of the tunnel Henrik creates in Cloudflare Zero Trust. Only the
# tunnel unit reads it, through a 0600 file in its runtime directory (sky/deploy/tunnel-token.sh).
SKY_CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare R2 (KC-0185): the backup bucket (clawco-sky-backup, EU jurisdiction, free tier); every copy is
# encrypted in Sky before upload. A bucket-scoped token (object read/write on that bucket only) is enough. All
# four or none: none = no backups (said at start); some = no backups and an error naming the missing keys.
SKY_R2_ACCOUNT_ID=
SKY_R2_ACCESS_KEY_ID=
SKY_R2_SECRET_ACCESS_KEY=
SKY_R2_BUCKET=
# Optional. The bucket's jurisdiction in the endpoint (<account>.<jurisdiction>.r2.cloudflarestorage.com);
# unset = eu, set but empty = the plain endpoint.
SKY_R2_JURISDICTION=
# Optional. The internal test tenant's slug: always part of the monthly restore drill.
SKY_KOPI_TESTTENANT=

# Optional (KC-0186). Where an upgrade's restore points go while R2 is not set up: an absolute path, made 0700.
# Unset = /srv/sky/kopier. On the host's own disk: a restore point for a rollout, not an offsite backup.
SKY_LOKALE_KOPIER=

# Mail (KC-0178): Resend, sending from its EU region (eu-west-1). The sending domain must be verified in
# Resend with open and click tracking off, or every send refuses. A full-access key is needed: a
# sending-only key cannot read the domain, so tracking cannot be proven off and sending refuses.
# Unset: every mail refuses (no login links by mail); with SKY_DEV=1 the fake outbox is used instead.
SKY_RESEND_API_KEY=
# Optional. The sender, "Name <address@domain>"; default Clawco <hej@> on the tenant domain.
SKY_POST_AFSENDER=

# Tenant key envelope (KC-0181): Sky's master key, 32 random bytes in base64. Made ON THE HOST by
# sky/scripts/ny-masternoegle.sh (never pasted, never shown; see sky/deploy/NOEGLE.md for the sealed offline
# copy). Required whenever SKY_FLAADE is lokal or hetzner: Sky refuses to start without it, and /health says
# "noegler: mangler". It only wraps each customer's own data key; losing it makes every backup unreadable.
SKY_MASTERNOEGLE=
# Optional. The master key's version (default 1); bumped by sky/scripts/ny-masternoegle.sh --roter.
SKY_MASTERNOEGLE_VERSION=
# Only while a rotation runs: the previous master key (version - 1), accepted for unwrapping until
# sky/scripts/roter-masternoegle.ts has re-wrapped every key (then ny-masternoegle.sh --afslut removes it).
SKY_MASTERNOEGLE_FORRIGE=
