{
  "name": "clawco-sky",
  "version": "0.1.0",
  "private": true,
  "description": "Clawco Sky: kontrolplanet for den hostede Clawco. Egen pakke, aldrig i tenant-billedet.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "stripe:opsaet": "node --env-file-if-exists=.env scripts/stripe-opsaet.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@simplewebauthn/server": "14.0.3",
    "hono": "4.13.14",
    "pg": "8.23.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "linkedom": "0.18.14",
    "typescript": "5.9.3"
  }
}
