# Clawco settings. install.sh writes its own .env from this list (every key it does not set stays commented); a hand
# install copies this file to .env. Never commit .env.
# An installation that already runs Hermes (kira-home) keeps its own .env with KC_AGENT=hermes-http; this file's default is for a NEW install.
KC_PORT=8750
KC_HOST=127.0.0.1
# KC-0160: laptop mode (install.sh --laptop): one owner on this machine only. ja = on (KC_HOST must then stay on
# loopback, or Clawco refuses to start); the Tailscale identity header is ignored and Start leaves the household
# question out. Empty = off.
KC_LAPTOP=
# KC-0017: canonical address; `kontrol/` (short name) redirects here. Empty = no redirect.
KC_ADRESSE=https://<name>.<tailnet>.ts.net
KC_DATA_DIR=/home/henrik/kontrolcenter-data
# KC-0246: set by Clawco Sky only (the owner's sign-up language, da or en): the language a NEW data folder starts in instead of English. Never changes a folder already in use. Empty = as before.
KC_SPROG=
# KC-0132/KC-0127: the env file keys saved in Start go to (this file, as the service reads it). Empty = .env in the working dir
KC_ENV_FILE=
# KC-0068: the test world's rum-lager (testtilstand). Optional; empty = <KC_DATA_DIR>-test, a sibling of the real one.
KC_TEST_DATA_DIR=
# KC-0245: which agent answers. direkte (the default for a new install) = Clawco's built-in agent: the only thing it needs
# is a key from a model provider (or a local model), pasted in Start's step 2. fake = scripted answers for local dev.
# hermes-http = your own Hermes agent (advanced, see the block below). Unset = hermes-http, so an install from before
# the built-in agent keeps running as it did.
KC_AGENT=direkte
# KC-0181/KC-0245: with the built-in agent, the model keys pasted in Start are saved encrypted (AES-256-GCM) in
# <KC_DATA_DIR>/hemmeligheder.enc. This names the file holding the 32-byte (base64) key that encrypts them; install.sh
# makes it (mode 600, outside the user folder, so a backup of the data folder never carries it) and never overwrites it.
# Empty = keys are read from KC_MODEL_NOEGLE_<PROVIDER> in the environment and a key pasted in Start is lost on restart.
KC_HEMMELIGHEDER_FIL=
# KC-0263: GitHub Copilot with the built-in agent signs in with GitHub (OAuth device flow: no client secret, no callback
# address). The id of the OAuth App to sign in through; empty = Clawco's own. Without any id, Start says GitHub sign-in
# is not set up here. The token lands in the encrypted store above, never in this file.
KC_GITHUB_CLIENT_ID=
# --- Advanced: use your own Hermes agent (KC_AGENT=hermes-http; install.sh --agent-url URL) ---
KC_HERMES_URL=http://127.0.0.1:8642
# Must equal API_SERVER_KEY in ~/.hermes/.env. Empty = the app still starts; Start's step 2 asks for it (KC-0127)
KC_HERMES_API_KEY=
# KC-0127: Hermes' own env file on this host, where Start's step 2 writes a model key. Empty = the card shows the command to run instead
KC_HERMES_ENV_FILE=
# KC-0127: how the gateway is restarted after such a write. Empty = hermes gateway restart
KC_HERMES_GENSTART=
# Where Kira's morning-paper pipeline writes today's data (see hermes-kira-state)
KC_DAGEN_SOURCE_GLOB=/tmp/avis_data_{date}.json
# Mail: Hermes' state dir with Kiras mail-plan-auto-*.json, and the himalaya binary
KC_MAIL_STATE_DIR=/home/henrik/.hermes/state
KC_HIMALAYA=/home/henrik/.local/bin/himalaya
# Skrive: where "Gem i Obsidian" writes notes. KC-0136: empty = <vault chosen on the Noter card>/00-Indbakke; set = the NAS vault (kira-noter).
KC_VAULT_INBOX=/mnt/nas-obsidian/ObsidianVault/00-Indbakke
# KC-0142/KC-0213: THE vault root, one answer for everything Clawco writes in your folders (rules file <vault>/Clawco/regler.md,
# the ledgers, the inbox, the register). Empty = the parent of KC_VAULT_INBOX, else the vault chosen on the Noter card, else <KC_DATA_DIR>/vault.
# The ledgers sit at <vault>/Clawco/Regnskab/<shelfatlas|privat>.md unless <KC_DATA_DIR>/regnskab.json names other paths relative to the vault
# ({"shelfatlas": "...", "privat": "..."}); ledgers already at the older paths (30-Projekter/ShelfAtlas/Regnskab.md, 10-Privat/Økonomi/abonnementer.md) are adopted at start.
KC_VAULT_DIR=
# KC-0023: the vault's shared people register; Hermes names people from it. KC-0136: empty = <chosen vault>/40-Mennesker/People, else his memory only.
KC_PEOPLE_DIR=/mnt/nas-obsidian/ObsidianVault/40-Mennesker/People
# Frontloading: rooms rebuilt at Copenhagen times (room=HH:MM,HH:MM;room=…)
KC_FRONTLOAD=mail=06:50,12:00,17:00
# KC-0028: Kuratoren — hours fra-til / every N minutes; empty or "fra" = off
KC_KURATOR=07-22/60
# KC-0152: the Saturday conflict — Tuesdays from this time Husstanden checks the coming weekend; empty or "fra" = off
KC_LORDAGSKONFLIKT=07:30
# Week view: the calendar script (defaults to scripts/kalender_uge.py in the repo, but only where Kira's
# ~/.hermes/scripts/google_token_refresh.py exists — KC-0133)
KC_KALENDER_SCRIPT=/home/henrik/kontrolcenter/scripts/kalender_uge.py
# KC-0133: "Log ind med Google" for the calendar — this install's own Google OAuth client (Web application,
# read-only calendar). Set from the calendar card in Start (key name + length only); never committed.
KC_GOOGLE_CLIENT_ID=
KC_GOOGLE_CLIENT_SECRET=
# Stemme (KC-0015): ElevenLabs key for tale-ind, oplæsning og Samtale (scripts/set-secret.sh).
# Unset = no voice in the UI. KC_STEMME_MODE=fake (default under npm run dev) needs no key.
KC_ELEVENLABS_API_KEY=
# KC-0179: who is looking. tailnet (default) = Tailscale Serve's identity headers; konto = Clawco Sky: only the
# Clawco-Konto header signed by the Sky gateway counts. In konto mode all four below are required (KC_KONTO_PUBKEY_NY
# only while the gateway key rotates); a missing or invalid one refuses to start, naming the key.
KC_IDENTITET=
# konto: this tenant's id at Sky (lowercase letters, digits, hyphen; max 40)
KC_KONTO_TENANT=
# konto: the gateway's Ed25519 public key, raw 32 bytes base64url; _NY = the next key during rotation
KC_KONTO_PUBKEY=
KC_KONTO_PUBKEY_NY=
# konto: the one private IP address the gateway connects from
KC_KONTO_GATEWAY=
# KC-0201: under Clawco Sky the settings show "Få hjælp", a link to the account app's help page. Both must be set:
# KC_SKY=ja and KC_SKY_URL (Sky's public address, https). A self-installed Clawco leaves them empty and never shows it.
KC_SKY=
KC_SKY_URL=
